# TST2SK Configuration
# API keys — edit these directly. Do NOT share this file.
#
# Active provider: (set by setup.py)

# ─── API Keys (edit directly, comma-separated for multiple) ─────
AI_API_KEY_GOOGLE=your-google-key-1,your-google-key-2,your-google-key-3
AI_API_KEY_OPENROUTER=your-openrouter-key-here
AI_API_KEY_LMSTUDIO=lm-studio

# ─── Active Provider Settings ───────────────────────────────────
AI_LLM_PROVIDER=Google_API
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.1-flash-lite
AI_MULTIMODAL_MODEL=true

# ─── Google Round-Robin ─────────────────────────────────────────
# Rotate API key every N requests (only applies to Google with multiple keys)
AI_ROUND_ROBIN_SWITCH=3

# ─── Optional ───────────────────────────────────────────────────
AI_EXTRA_HEADERS=

# ═══════════════════════════════════════════════════════════════
# REFERENCE — DO NOT UNCOMMENT (for your info only)
# ═══════════════════════════════════════════════════════════════
#
# Providers:
#   Google_API        → AI_API_KEY_GOOGLE
#   OpenRouter        → AI_API_KEY_OPENROUTER
#   Local_(LMStudio)  → AI_API_KEY_LMSTUDIO
#
# Base URLs:
#   Google    : https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter: https://openrouter.ai/api/v1/
#   LMStudio  : http://localhost:1234/v1/
#
# Google Models:
#   gemini-3.1-flash-lite, gemma-4-31b-it, gemma-4-26b-a4b-it
#
# OpenRouter Models (free):
#   openrouter/free, poolside/laguna-m.1:free, openrouter/owl-alpha
#   nvidia/nemotron-3-super-120b-a12b:free, minimax/minimax-m2.5:free
#   inclusionai/ring-2.6-1t:free
#
# Run "Setup TST2SK.bat" to switch providers/models interactively.
